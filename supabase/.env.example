# Copiar a supabase/.env (ignorado por git) y completar. Solo nombres acá: nunca valores.
# Edge Functions en local: supabase functions serve --env-file supabase/.env
# En la nube se cargan desde la web, nunca desde un archivo (ver docs/architecture/04-infrastructure.md).

# Edge Function del ticket (ADR-012). Groq siempre del lado del servidor (RNF-04).
# En la nube: panel de Supabase → Edge Functions → Secrets.
GROQ_API_KEY=

# Script de ingesta (letra chica, #51). En GitHub Actions es un secret del repo.
GEMINI_API_KEY=

# URL pública del proyecto (no es secreta). La usa la ingesta de promociones; en GitHub
# Actions sale de los secrets del repo (.github/workflows/ingesta.yml). A mano:
#   node --env-file=supabase/.env ingesta/src/corpus/ingestar.ts
SUPABASE_URL=

# Proceso de ingesta, no Edge Functions (RNF-05). Saltea RLS: llave maestra.
# No cargar con `supabase secrets set`: Supabase rechaza nombres SUPABASE_* y ya
# inyecta la suya en las Edge Functions.
SUPABASE_SERVICE_ROLE_KEY=
